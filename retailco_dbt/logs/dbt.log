        (raw_data->>'paidAt')::timestamptz         as paid_at,
        (raw_data->>'createdAt')::timestamptz      as created_at,
        (raw_data->>'updatedAt')::timestamptz      as updated_at,
        _extracted_at
    from source
),
classified as (
    select *,
        case
            when amount_paid = 0
                then 'zero_amount'
            when amount_paid < 0
