),
typed as (
    select
        (raw_data->>'id')::text                    as payment_id,
        (raw_data->>'orderId')::text               as order_id,
        (raw_data->>'customerId')::text            as customer_id,
        (raw_data->>'paymentMethodId')::text       as payment_method_id,
        (raw_data->>'amountPaid')::numeric(12,2)   as amount_paid,
